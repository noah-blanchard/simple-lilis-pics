{
  "name": "lilis-pics",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@lili/web",
    "dev:admin": "turbo run dev --filter=@lili/admin",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check",
    "format": "biome format --write",
    "fix": "biome check --write",
    "fix:unsafe": "biome check --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "turbo": "2.11.10"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
