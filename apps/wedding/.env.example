# Public origin of this app (local: http://localhost:3052, prod: https://wedding.lilispics.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3052

# Supabase — same project as the other apps. Used by the wedding data layer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=photos
# SECRET — must equal REVALIDATE_SECRET in apps/admin (runtime only).
REVALIDATE_SECRET=

# ─────────────────────────────────────────────────────────────
# Server secrets for the reply card (runtime only, never Docker build args)
# ─────────────────────────────────────────────────────────────
# SECRET, server only. Used by POST /api/inquiry (bypasses RLS to store the card).
SUPABASE_SERVICE_ROLE_KEY=
# SECRET, server only. Resend API key for the notification email.
RESEND_API_KEY=
# Inbox that receives reply-card notifications.
CONTACT_TO_EMAIL=hello@lilispics.com
# Sender address on a domain verified in Resend, e.g. "Lilis Pics <hello@lilispics.com>".
CONTACT_FROM_EMAIL=
