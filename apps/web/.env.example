# ─────────────────────────────────────────────────────────────
# Supabase — get these values from the Supabase dashboard:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────

# Project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key — exposed to the browser (secured by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SECRET, server only, NEVER expose to the client.
# Used only in the /api route handlers (bypasses RLS for upload/CRUD).
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name (created in the storage migration)
NEXT_PUBLIC_SUPABASE_BUCKET=photos

# ─────────────────────────────────────────────────────────────
# Site — used for absolute metadata URLs (Open Graph, canonical).
# ─────────────────────────────────────────────────────────────

# This app's public origin. Local: http://localhost:3050 — production:
# https://lilispics.com. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────
# Resend — transactional email for the contact form.
#   Create a key at https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────

# Resend API key — SECRET, server only, NEVER expose to the client.
# Used only in the /api/contact route handler.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=hello@lilispics.com

# Sender address for the notification email. Must be on a domain verified
# in the Resend dashboard (Domains → Add Domain), e.g. "Lilis Pics <hello@lilispics.com>".
CONTACT_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────
# Cross-app wiring
# ─────────────────────────────────────────────────────────────

# Shared secret for POST /api/revalidate (server-to-server, from the admin app).
# SECRET — must equal REVALIDATE_SECRET in apps/admin. Generate with:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Admin origin. Old /admin and /login URLs redirect here. Read at BUILD time.
ADMIN_URL=http://localhost:3051
