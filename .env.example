# ─────────────────────────────────────────────────────────────
# Supabase — récupérer ces valeurs dans le dashboard Supabase :
#   Project Settings → API
# ─────────────────────────────────────────────────────────────

# URL du projet (ex: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé "anon / public" — exposée au navigateur (sécurisée par la RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SECRÈTE, serveur uniquement, ne JAMAIS exposer au client.
# Utilisée seulement dans les route handlers /api (bypass RLS pour upload/CRUD).
SUPABASE_SERVICE_ROLE_KEY=

# Nom du bucket Storage (créé à l'étape 4)
NEXT_PUBLIC_SUPABASE_BUCKET=photos

# ─────────────────────────────────────────────────────────────
# OpenRouter — traduction IA des champs du formulaire admin.
#   Créer une clé sur https://openrouter.ai/keys
# ─────────────────────────────────────────────────────────────

# Clé API OpenRouter — SECRÈTE, serveur uniquement, ne JAMAIS exposer au client.
# Utilisée seulement dans le route handler /api/translate.
OPENROUTER_API_KEY=

# Modèle utilisé pour la traduction (optionnel — défaut: Llama 3.3 70B gratuit)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
